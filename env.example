# --- LLM Provider Configuration ---
LLM_PROVIDER=gemini
# Set this locally; never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Lower this if indexing runs out of memory; restart the backend after changing it.
EMBEDDING_BATCH_SIZE=32

# --- Crawler Defaults ---
CRAWLER_MAX_PAGES=5000
CRAWLER_REQUEST_TIMEOUT=15
CRAWLER_USER_AGENT=PyNexusBot/1.0 (+https://localhost)
CRAWLER_DEPTH_LIMIT=0
CRAWLER_DOWNLOAD_DELAY=0.2
CRAWLER_RETRY_TIMES=2
CRAWLER_AUTOTHROTTLE_MAX_DELAY=10
CRAWLER_CONCURRENT_REQUESTS_PER_DOMAIN=2

# --- RAG Settings ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5

# --- Storage Paths (relative to backend/) ---
DATA_DIR=data
RAW_DIR=data/raw
INDEX_DIR=db/faiss_index

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

